{
  "expo": {
    "name": "Beyou",
    "slug": "beyou-mobile",
    "version": "1.1.0",
    "primaryColor": "#1D6BF3",
    "scheme": "beyou",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/Beyou.icon",
      "bundleIdentifier": "com.beyou.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.beyou.mobile",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#1D6BF3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beyou opens your photo library only when you choose a profile photo or attach a screenshot to a feedback report.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-router",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "@sentry/react-native/expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1218"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "pt": "./locales/pt.json"
    }
  }
}
