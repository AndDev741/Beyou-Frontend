# Backend API base (versioned). Example: http://192.168.1.164:8099/api/v1
EXPO_PUBLIC_API_URL=

# Google sign-in: the OAuth 2.0 **Web** client id (…apps.googleusercontent.com).
# Passed to GoogleSignin.configure({ webClientId }) so the returned ID token's
# audience is the web client — which the backend's GOOGLE_MOBILE_AUDIENCES accepts.
# The Android OAuth client (package + SHA-1) is matched by Google automatically and
# is NOT referenced here. Client ids are public identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Error telemetry: the DSN of the self-hosted GlitchTip collector, which speaks
# the Sentry ingest API. Example: http://<key>@localhost:8000/1
#
# Leave EMPTY to disable error reporting completely — with no DSN the SDK is
# never initialised and nothing is sent (same posture as the backend's
# SENTRY_DSN). A DSN is a public ingest identifier, not a secret, but keep real
# values in .env only, never in this tracked example.
#
# ⚠️  Mobile delivery is NOT yet verified end-to-end. Setting this does not prove
# events arrive: confirm by throwing a deliberate error from a RELEASE build on a
# PHYSICAL device and watching it land in GlitchTip. See src/lib/telemetry.ts.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics: the PostHog Cloud project API key (starts with "phc_").
#
# Leave EMPTY to disable analytics completely — with no key the client is never
# constructed and nothing is captured (same posture as EXPO_PUBLIC_SENTRY_DSN).
# The key is a public ingest identifier, not a secret, but keep real values in
# .env only. The host defaults to the US cloud; the Beyou project lives on the
# EU cloud, so set it in any env that captures for real.
EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://ph.beyouweb.com (first-party reverse proxy → PostHog EU)

# Address behind the "Send by email" fallback on the feedback form and the crash
# screen. It is the escape hatch: the way a report still reaches a human when the
# API cannot take it, so it must be a mailbox someone actually reads.
#
# Leave EMPTY to use the built-in default (support@beyou.app). That default is
# NOT verified — confirm the mailbox exists and is monitored, or set this.
EXPO_PUBLIC_FEEDBACK_EMAIL=
