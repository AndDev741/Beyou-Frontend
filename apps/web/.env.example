VITE_API_URL=http://localhost:8099
VITE_APP_URL=http://localhost:3000
# Address behind the feedback screen's "send by email" alternative (KD6: an
# outbound mailto escape hatch, NOT an inbound ingestion pipeline).
VITE_FEEDBACK_EMAIL=support@beyou.app

# Error telemetry: the DSN of the self-hosted GlitchTip collector, which speaks
# the Sentry ingest API. Example: http://<key>@localhost:8000/1
#
# Leave EMPTY to disable error reporting completely — with no DSN the SDK is
# never initialised and nothing is sent (same posture as the backend's SENTRY_DSN
# and mobile's EXPO_PUBLIC_SENTRY_DSN). A DSN is a public ingest identifier, not
# a secret, but keep real values in .env only, never in this tracked example.
VITE_SENTRY_DSN=

# --- Source-map upload (build-time only, NOT read by the browser) -------------
# Without these, production stack traces stay minified. They are consumed by
# @sentry/vite-plugin during `npm run build`; upload is skipped unless
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT are ALL set, so an ordinary
# developer build needs none of them.
#
# ⚠️  SENTRY_AUTH_TOKEN IS A REAL SECRET (unlike the DSN). Supply it from the CI
# secret store. Never commit it, and never pass it as a Docker build ARG — build
# args are readable in `docker history`.
#
# SENTRY_URL is the GlitchTip base URL (GLITCHTIP_DOMAIN in Beyou-dev-env/.env);
# omit it and the plugin uploads to sentry.io instead. SENTRY_ORG is the
# GlitchTip organisation slug, SENTRY_PROJECT the project slug.
# SENTRY_RELEASE optionally overrides the release name the events and the maps
# are both tagged with; it defaults to beyou-web@<package.json version>. CI
# should set it to the same commit-derived value the backend uses.
# SENTRY_URL=http://localhost:8000
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=
